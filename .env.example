# === Discord ===
# 每個公司 / Discord server 的 ID 都會不同；請用「用途」對應到該公司的實際 ID。
DISCORD_TOKEN=你的_discord_bot_token
DISCORD_CLIENT_ID=你的_discord_application_client_id
# 僅放本機 .env；不要提交或貼到聊天
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/discord/oauth/callback
GUILD_ID=你的伺服器ID
SCHEDULE_CHANNEL_ID=時間管理頻道ID
ADMIN_ROLE_ID=控方或管理者身分組ID
# 任務查詢入口頻道（可留空；留空時任務指令不限制頻道）
TASK_CHANNEL_ID=
# 會議秘書小律頻道（留空則不限制）
AI_CHANNEL_ID=
# 小律 LLM（未填 LLM_API_KEY 時小律不會啟用回答）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_MAX_TOKENS=800
# 每日 token 護欄；0 表示不限
LLM_DAILY_TOKEN_LIMIT=0
LLM_PER_ARTIST_DAILY_TOKEN_LIMIT=0
# 排除清單：這些「會議類型」永遠不開放給小律，即使 Notion 藝人可見=true 也一樣；
# 其餘類型（含之後新增的任何類型）預設開放，只靠「藝人可見」逐筆把關。
# 這是產品層級的安全預設，通常在建置時設定一次，不需要客戶為了新類型自行調整。
QA_HIDDEN_MEETING_TYPES=課程,課程會議,公司例會,管理層會議
# 管理通知頻道（可留空，預設用排課頻道）
ADMIN_NOTIFY_CHANNEL_ID=
# 營運操作頻道（可留空，預設沿用管理通知頻道）
ADMIN_COMMAND_CHANNEL_ID=
# 公告區頻道（可留空，預設發到時間管理；建議設唯讀頻道，正式通告與收集公告會發這裡）
ANNOUNCE_CHANNEL_ID=
# 會額外發到公告區的 Tasks 類型；其他類型只私訊關聯藝人
PUBLIC_TASK_TYPES=通告,演出,拍攝
# Notion 布告欄同步到哪個 Discord 頻道；留空時使用 ANNOUNCE_CHANNEL_ID
BULLETIN_CHANNEL_ID=
# 布告欄背景同步間隔（分鐘）
BULLETIN_SYNC_INTERVAL_MINUTES=5
# 任務／月度時間池背景提醒輪詢間隔（分鐘）；測試可填 0.5＝30 秒，正式建議 10～30
REMINDER_INTERVAL_MINUTES=30
# 待審核提交持續提醒控方／指定審核人員的間隔（小時）；正式建議 12，測試可填 0.5
REVIEW_REMINDER_INTERVAL_HOURS=12
# 提交後滿幾小時仍未審核才發出第一次催辦；預設 24 小時
REVIEW_REMINDER_AFTER_HOURS=24
# Tasks「提醒規則」留空時套用的預設；值必須是 Notion 既有選項（3 天前／1 天前／當天／逾期）
# 預設只有「當天」：要提前交件請勾「提前交件」，不要靠這裡塞 5 天前
DEFAULT_REMINDER_RULES=當天
# 「提前交件」任務沒填「提交期限」時，交件死線＝截止日往前推幾天
APPROVAL_LEAD_DAYS=5

# === Notion ===
NOTION_TOKEN=你的_notion_internal_integration_token

# 九組 Data Source ID 全部必填，沒有預設值。
# 缺任何一組 bot 會在啟動時直接失敗——連到錯誤的資料庫比連不上更難發現。
# 取得方式：在 Notion 開啟該資料庫 → 右上「...」→ Copy link，
# 網址 /<這段 32 碼>?v=... 就是 ID（加不加連字號都可以）。
# 每個資料庫都要 share 給你的 integration，否則查詢會回 404。
NOTION_DS_ARTISTS=
NOTION_DS_AVAILABILITY_SLOTS=
NOTION_DS_AUDIT_LOG=
NOTION_DS_TASKS=
NOTION_DS_PROJECTS=
NOTION_DS_PEOPLE=
NOTION_DS_SUBMISSIONS=
NOTION_DS_BULLETIN=
NOTION_DS_COURSE_MEETINGS=

# === Google Drive 作業歸檔（設定教學見 DRIVE_OAUTH_SETUP.md）===
# 總資料夾 ID（Drive 網址 folders/ 後面那串；留空＝停用檔案歸檔，僅連結/文字提交）
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# OAuth 憑證路徑（照教學產生；credentials/ 已在 .gitignore，不會入庫）
GOOGLE_OAUTH_CLIENT_PATH=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json

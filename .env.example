# === Discord ===
# 每個公司 / Discord server 的 ID 都會不同；請用「用途」對應到該公司的實際 ID。
DISCORD_TOKEN=你的_discord_bot_token
DISCORD_CLIENT_ID=你的_discord_application_client_id
# 僅放本機 .env；不要提交或貼到聊天
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/discord/oauth/callback
GUILD_ID=你的伺服器ID
SCHEDULE_CHANNEL_ID=時間管理頻道ID
ADMIN_ROLE_ID=控方或管理者身分組ID
# 任務查詢入口頻道（可留空；留空時任務指令不限制頻道）
TASK_CHANNEL_ID=
# 會議秘書小律頻道（留空則不限制）
AI_CHANNEL_ID=
# 小律 LLM（未填 LLM_API_KEY 時小律不會啟用回答）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_MAX_TOKENS=800
# 每日 token 護欄；0 表示不限
LLM_DAILY_TOKEN_LIMIT=0
LLM_PER_ARTIST_DAILY_TOKEN_LIMIT=0
# 排除清單：這些「會議類型」永遠不開放給小律，即使 Notion 藝人可見=true 也一樣；
# 其餘類型（含之後新增的任何類型）預設開放，只靠「藝人可見」逐筆把關。
# 這是產品層級的安全預設，通常在建置時設定一次，不需要客戶為了新類型自行調整。
QA_HIDDEN_MEETING_TYPES=課程,課程會議,公司例會,管理層會議
# 管理通知頻道（可留空，預設用排課頻道）
ADMIN_NOTIFY_CHANNEL_ID=
# 營運操作頻道（可留空，預設沿用管理通知頻道）
ADMIN_COMMAND_CHANNEL_ID=
# 公告區頻道（可留空，預設發到時間管理；建議設唯讀頻道，正式通告與收集公告會發這裡）
ANNOUNCE_CHANNEL_ID=
# 會額外發到公告區的 Tasks 類型；其他類型只私訊關聯藝人
PUBLIC_TASK_TYPES=通告,演出,拍攝
# 無條件硬擋藝人可配合時段的任務類型（M1-05）；值必須是 Notion「任務類型」的既有
# 選項，寫不存在的選項永遠不命中。新增任務類型想套用這個行為，改這行就好，不用改程式碼。
HARD_BLOCK_TASK_TYPES=錄音,演出,會議溝通
# 不判逾期的專案類型（M5-03）；值必須是 Notion「專案類型」的既有選項。
# 新增專案類型想套用「不判逾期」，改這行就好。
NO_OVERDUE_PROJECT_TYPES=課程培訓
# 發文類停在「已完成」的待確認發布彙整（M2-05），發到控方頻道，一則彙整。
# 星期幾：0＝週一 … 6＝週日，或填 daily（每天）。幾點：0～23。
# 天數：截止日已過幾天才列入（Tasks 沒有完成時間欄位，用截止日估）。
PUBLISH_CONFIRM_DIGEST_WEEKDAY=0
PUBLISH_CONFIRM_DIGEST_HOUR=10
PUBLISH_CONFIRM_DIGEST_AFTER_DAYS=3
# Notion 布告欄同步到哪個 Discord 頻道；留空時使用 ANNOUNCE_CHANNEL_ID
BULLETIN_CHANNEL_ID=
# 布告欄背景同步間隔（分鐘）
BULLETIN_SYNC_INTERVAL_MINUTES=5
# 任務／月度時間池背景提醒輪詢間隔（分鐘）；測試可填 0.5＝30 秒，正式建議 10～30
REMINDER_INTERVAL_MINUTES=30
# （已停用）待審核原本每 12 小時催一次，2026-10-11 起併入每日催辦，此值不再生效
REVIEW_REMINDER_INTERVAL_HOURS=12
# 提交後滿幾小時仍未審核，才會列入每日催辦；預設 24 小時
REVIEW_REMINDER_AFTER_HOURS=24
# 每日催辦（M3-11）幾點跑：已逾期／需修改催藝人、待審核催審核人員；預設上午 10 點
DAILY_NAG_HOUR=10
# 課後提醒老師（M5-01）：課程結束（截止日）後幾小時發第一次；之後每天在 DAILY_NAG_HOUR 再催，
# 直到控方結案；最多催幾天，之後改通知控方一次，不再催老師。
TEACHER_REMINDER_AFTER_HOURS=2
TEACHER_REMINDER_MAX_DAYS=7
# Tasks「提醒規則」的預設值；值必須是 Notion「提醒規則」的既有選項，寫不存在的永遠不命中。
# 預設＝D-5 ＋ D-3（09/22 會議「兩個節點並行」）。
# 注意：預設與任務勾選的規則是**聯集**，不是替換 —— 預設永遠生效，勾選只能往上加。
# 所以每個任務至少都會收到這裡列的幾次提醒，控方無法用勾選減少；要減少就改這一行。
# 天數從「追蹤期限」往前算（勾了「提前交件」就是交件日，不是截止日）。
DEFAULT_REMINDER_RULES=5 天前,3 天前
# 「提前交件」任務沒填「提交期限」時，交件死線＝截止日往前推幾天
APPROVAL_LEAD_DAYS=5

# === Notion ===
NOTION_TOKEN=你的_notion_internal_integration_token

# 九組 Data Source ID 全部必填，沒有預設值。
# 缺任何一組 bot 會在啟動時直接失敗——連到錯誤的資料庫比連不上更難發現。
# 取得方式：在 Notion 開啟該資料庫 → 右上「...」→ Copy link，
# 網址 /<這段 32 碼>?v=... 就是 ID（加不加連字號都可以）。
# 每個資料庫都要 share 給你的 integration，否則查詢會回 404。
NOTION_DS_ARTISTS=
NOTION_DS_AVAILABILITY_SLOTS=
NOTION_DS_AUDIT_LOG=
NOTION_DS_TASKS=
NOTION_DS_PROJECTS=
NOTION_DS_PEOPLE=
NOTION_DS_SUBMISSIONS=
NOTION_DS_BULLETIN=
NOTION_DS_COURSE_MEETINGS=

# === Google Drive 作業歸檔（設定教學見 DRIVE_OAUTH_SETUP.md）===
# 總資料夾 ID（Drive 網址 folders/ 後面那串；留空＝停用檔案歸檔，僅連結/文字提交）
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# 服務帳號金鑰優先於下面的 OAuth（兩者都設定時服務帳號贏）。推薦走這條——
# 沒有同意畫面、沒有 refresh token，不會像 OAuth 使用者授權那樣在 Google Cloud
# 專案處於「測試中」狀態時 7 天不活動就失效。
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=credentials/service_account.json
# OAuth 憑證路徑（舊方式，仍相容；credentials/ 已在 .gitignore，不會入庫）
GOOGLE_OAUTH_CLIENT_PATH=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json

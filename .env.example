# === Discord ===
DISCORD_TOKEN=你的_discord_bot_token
GUILD_ID=你的伺服器ID
SCHEDULE_CHANNEL_ID=排課頻道ID
ADMIN_ROLE_ID=管理者身分組ID
# 管理通知頻道（可留空，預設用排課頻道）
ADMIN_NOTIFY_CHANNEL_ID=

# === Notion ===
NOTION_TOKEN=你的_notion_internal_integration_token

# 正式資料層 = KariKari 營運中心（Data Source ID 預設值已寫在 config.py，通常不需要改）

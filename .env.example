# === Discord ===
# 每個公司 / Discord server 的 ID 都會不同；請用「用途」對應到該公司的實際 ID。
DISCORD_TOKEN=你的_discord_bot_token
GUILD_ID=你的伺服器ID
SCHEDULE_CHANNEL_ID=時間資訊彙整頻道ID
ADMIN_ROLE_ID=控方或管理者身分組ID
# 任務查詢入口頻道（可留空；留空時任務指令不限制頻道）
TASK_CHANNEL_ID=
# 管理通知頻道（可留空，預設用排課頻道）
ADMIN_NOTIFY_CHANNEL_ID=
# 公告區頻道（可留空，預設發到時間資訊彙整；建議設唯讀頻道，正式通告與收集公告會發這裡）
ANNOUNCE_CHANNEL_ID=

# === Notion ===
NOTION_TOKEN=你的_notion_internal_integration_token

# 正式資料層 = KariKari 營運中心（Data Source ID 預設值已寫在 config.py，通常不需要改）
# NOTION_DS_ARTISTS=c0253aec-d18c-47de-a92f-e4a6f9eda641
# NOTION_DS_SCHEDULE_REQUESTS=028529f8-42ea-41f2-ba81-68d49c438f43
# NOTION_DS_AVAILABILITY_SLOTS=3726792b-a0f2-47f0-9fb2-2a49a0444266
# NOTION_DS_COURSE_SESSIONS=12402cad-242d-4caf-978f-9f56b794e646
# NOTION_DS_AUDIT_LOG=af855535-af5a-42b7-922a-4bc96449b267

# === Google Drive 作業歸檔（設定教學見 DRIVE_OAUTH_SETUP.md）===
# 總資料夾 ID（Drive 網址 folders/ 後面那串；留空＝停用檔案歸檔，僅連結/文字提交）
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# OAuth 憑證路徑（照教學產生；credentials/ 已在 .gitignore，不會入庫）
GOOGLE_OAUTH_CLIENT_PATH=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json

# === 老師外部確認連結（Phase 2；留空＝停用）===
# 任意長隨機字串，用來簽名老師確認連結；不要 commit 真實值
TEACHER_LINK_SECRET=
# 對外網址，例如 Cloudflare Tunnel URL；開發期可先留空，bot 只會維持人工確認流程
TEACHER_LINK_BASE_URL=
# 本機 web server port；Tunnel 會轉到 http://127.0.0.1:8787
WEB_PORT=8787
